{
  "name": "@polymorph/webrtc-conformance-driver-ct-jco",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "jco legs (Node + headless browser) for the component-test conformance suite: transpile the suites, bind the browser-first host, the fetch mailbox, and the test-context shim, and emit one component-test results JSONL stream per invocation (a solo or single-role child of rtc-ct-driver).",
  "scripts": {
    "transpile": "component-test-jco-transpile transpile ../../../target/wasm32-wasip2/release/conformance_guest_ct.wasm --name conformance-guest-ct -I async -o generated",
    "transpile-pair": "component-test-jco-transpile transpile ../../../target/wasm32-wasip2/release/conformance_guest_pair_ct.wasm --name conformance-guest-pair-ct -I async -o generated-pair"
  },
  "devDependencies": {
    "@bytecodealliance/jco-transpile": "https://github.com/lann/jco/releases/download/jco-transpile-0.6.2-fa6990d/bytecodealliance-jco-transpile-0.6.2.tgz",
    "@bytecodealliance/preview2-shim": "^0.17.2",
    "@polymorph/component-test-js": "github:polymorph-components/polymorph-test#76c094576076284c1a7d0ea1b7bb724e9e7384a5",
    "playwright-core": "^1.61.1"
  },
  "engines": {
    "node": ">=24"
  }
}
