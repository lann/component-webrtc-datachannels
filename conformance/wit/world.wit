// The `conformance:suite` package: the world the shared conformance
// suite components are built against under the polymorph:test harness.
//
// The suite's export surface (the `polymorph:test` tests contract and
// the inventory section) comes from the component-test guest SDK; this
// package carries only the import side — the `connections` surface
// under test and the suite-owned signaling `mailbox`. Assertions target
// interoperable behavior only — never SDP contents, candidate ordering,
// timing, or exact error strings.
package conformance:suite@0.1.0;

/// The suite components' world. `solo/*` cases stand up both peers in
/// one instance; `pair/*` cases run as two role-paired instances whose
/// role, signaling server, and room seed arrive through the WASI
/// environment (`RTC_CT_*`), rendezvousing per case over the mailbox.
world sut-imports {
    import polymorph:webrtc-datachannels/connections@0.1.0;
    import conformance:signaling/mailbox@0.1.0;
}
