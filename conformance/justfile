# The conformance suite on the polymorph:test harness (see README.md
# here). Loaded as the `conformance` module of the top-level justfile:
# invoke as `just conformance` (full loopback + interop suite) or
# `just conformance::<recipe>`.
#
# Recipes run from the repository root so cargo invocations, `target/`
# binary paths, and `conformance/...` paths all match the top-level
# layout.
set working-directory := ".."

# The whole-run safety cap (seconds) per leg. Every case is already
# individually bounded (the runner's 90 s wall guard), so this only
# turns a systemic hang into minutes, not hours.
timeout := "600"

driver := "target/release/rtc-ct-driver"
suite := "target/wasm32-wasip2/release/conformance_guest_ct.wasm"
pair_suite := "target/wasm32-wasip2/release/conformance_guest_pair_ct.wasm"
composed := "target/wasm32-wasip2/release/composed/conformance_guest_ct.wasm"
composed_pair := "target/wasm32-wasip2/release/composed/conformance_guest_pair_ct.wasm"
results := "conformance/driver-ct/results"
ct_cli := "target/ct-tools/bin/component-test"
polyengine := "conformance/driver-ct/polyengine"

# The full conformance run: every loopback target, every interop
# direction, both aggregates, and the committed-matrix gates.
[doc("Run the loopback + interop conformance suites and gate the matrices")]
all: build lock-check run-wasmtime run-composed run-polyengine run-polyengine-browser run-interop aggregate matrix-check

# ---------------------------------------------------------------------------
# Builders.
# ---------------------------------------------------------------------------

# The two suite components (full and pair-only).
build-suites:
    cargo build --release --target wasm32-wasip2 \
        -p conformance-guest-ct -p conformance-guest-pair-ct

# The driver, the signaling server, and the reference peer.
build-driver:
    cargo build --release -p conformance-ct-driver -p conformance-adapter-reference
    cargo build -p conformance-signalingd

# The composed artifacts: each suite `wac plug`ged with the wasip3-impl
# provider (the whole WebRTC stack in wasm over wasi:sockets) and the
# in-guest wasi:http mailbox client.
build-composed: build-suites
    cargo build --release --target wasm32-wasip2 \
        -p wasip3-webrtc-datachannels -p conformance-wasip3-mailbox
    mkdir -p target/wasm32-wasip2/release/composed
    wac plug {{suite}} \
        --plug target/wasm32-wasip2/release/wasip3_webrtc_datachannels.wasm \
        --plug target/wasm32-wasip2/release/conformance_wasip3_mailbox.wasm \
        -o {{composed}}
    wac plug {{pair_suite}} \
        --plug target/wasm32-wasip2/release/wasip3_webrtc_datachannels.wasm \
        --plug target/wasm32-wasip2/release/conformance_wasip3_mailbox.wasm \
        -o {{composed_pair}}

build: build-suites build-driver build-composed

# The component-test CLI, installed --locked from the same git rev
# Cargo.lock pins for the library crates (the lock is the single source
# of truth; same-rev reruns are a no-op "already installed"). The
# bootstrap extraction anchors on the crate name, not the repository
# URL (URLs change on renames): the sdk's [[package]] block in
# Cargo.lock carries the git source to install from. The pins gate then
# asserts one rev everywhere across the Cargo-side crates. The JS
# runner core arrives from JSR now (@jsr/polymorph__test, version-pinned
# in the polyengine driver's package-lock.json) rather than a git rev, so it
# has its own one-version gate (scripts/check-polyengine-pin.sh's
# runner-js-pin-check) instead of a --js-lock leg here.
_ct-tools:
    #!/usr/bin/env bash
    set -euo pipefail
    src=$(grep -m1 -A2 '^name = "component-test-sdk"' Cargo.lock | grep '^source = "git+')
    url=$(printf '%s' "$src" | sed -E 's/^source = "git\+([^?]+)\?.*/\1/')
    rev=$(printf '%s' "$src" | grep -oE '[0-9a-f]{40}' | head -n1)
    if [ ! -x '{{ct_cli}}' ] || [ "$(cat target/ct-tools/.rev 2>/dev/null)" != "$rev" ]; then
        cargo install --locked --root target/ct-tools --git "$url" --rev "$rev" component-test-cli
        printf '%s' "$rev" > target/ct-tools/.rev
    fi
    {{ct_cli}} pins --cargo-lock Cargo.lock --expect "$rev" > /dev/null

# The committed lockfiles are the corpus inventories; drift fails here
# and in the runner's own cross-check.
lock-check: _ct-tools
    {{ct_cli}} lock {{suite}} --check conformance/guest-ct/tests.lock
    {{ct_cli}} lock {{pair_suite}} --check conformance/guest-pair-ct/tests.lock

# Regenerate the lockfiles after an intentional suite change and commit
# the diff (the diff is the review surface).
lock-update: build-suites _ct-tools
    {{ct_cli}} lock {{suite}} -o conformance/guest-ct/tests.lock
    {{ct_cli}} lock {{pair_suite}} -o conformance/guest-pair-ct/tests.lock

# ---------------------------------------------------------------------------
# Loopback legs (the full suite: solo stream + role-paired fold).
# ---------------------------------------------------------------------------

_results-dir:
    mkdir -p {{results}}

run-wasmtime: _results-dir
    timeout {{timeout}} {{driver}} loopback {{suite}} \
        --target wasmtime --kind wasmtime -o {{results}}/wasmtime.jsonl

run-composed: _results-dir
    timeout {{timeout}} {{driver}} loopback {{suite}} \
        --target composed --kind composed --artifact {{composed}} \
        -o {{results}}/composed.jsonl

# The polyengine leg's dependencies: Deno materializes the pinned module
# graph and the node-datachannel native addon (whose install script needs
# an explicit grant) into the leg's node_modules. Idempotent.
polyengine-deps:
    cd {{polyengine}} && deno install --frozen --allow-scripts=npm:node-datachannel

run-polyengine: _results-dir polyengine-deps
    timeout {{timeout}} {{driver}} loopback {{suite}} \
        --target polyengine-deno --kind polyengine-deno --script {{polyengine}}/run.ts \
        -o {{results}}/polyengine-deno.jsonl

# The polyengine browser driver's npm tree (the upstream page driver +
# playwright-core; no transpiler).
_polyengine-browser-prepared:
    #!/usr/bin/env bash
    set -euo pipefail
    cd {{polyengine}}
    if [ package-lock.json -nt node_modules/.package-lock.json ]; then
        npm ci --no-audit --no-fund
    fi

# The polyengine browser leg's runtime inputs: the pinned translator +
# embedder assets and the one deno-bundled page module (engine + host
# module + page loop) the static server serves. Shared by the loopback
# leg and the interop directions. The translator wasm is extracted from
# the lock-pinned module cache (no network, no sha bookkeeping — JSR
# package integrity is in the lock); see scripts/extract-polyengine-translator.py.
_polyengine-browser-bundle:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p target/polyengine-browser
    deno info --json --config {{polyengine}}/deno.json --frozen @polyengine/translator \
        > target/polyengine-browser/.polyengine-info.json
    pin=$(grep -o 'jsr:@polyengine/runtime@[^/"]*' {{polyengine}}/deno.json | head -1 | sed 's/.*@//')
    python3 scripts/extract-polyengine-translator.py \
        target/polyengine-browser/.polyengine-info.json \
        target/polyengine-browser/polyengine-translator-shim.wasm "$pin"
    (cd {{polyengine}}/browser && deno bundle --config deno.json --frozen --platform browser \
        -o ../../../../target/polyengine-browser/webrtc-page.mjs page-entry.ts)

# The suite runtime-linked inside headless Chromium against the polyengine
# host module (polyengine-impl over the browser's native RTCPeerConnection):
# the run happens in the page (RTCPeerConnection is Window-only), served
# as one deno-bundled module — no transpile step, no generated tree.
run-polyengine-browser: _results-dir polyengine-deps _polyengine-browser-prepared _polyengine-browser-bundle
    timeout {{timeout}} {{driver}} loopback {{suite}} \
        --target polyengine-browser --kind polyengine-browser --script {{polyengine}}/run-browser.mjs \
        -o {{results}}/polyengine-browser.jsonl

# ---------------------------------------------------------------------------
# Interop directions (the pair-only suite; every implementation against
# the reference peer in both orders, the reference self-pair, and the
# direct implementation pairs).
# ---------------------------------------------------------------------------

interop_directions := "wasmtime-x-reference reference-x-wasmtime polyengine-deno-x-reference reference-x-polyengine-deno polyengine-browser-x-reference reference-x-polyengine-browser wasip3-guest-x-reference reference-x-wasip3-guest wasmtime-x-polyengine-deno polyengine-deno-x-wasmtime wasmtime-x-wasip3-guest wasip3-guest-x-wasmtime"

# The polyengine children join interop directions the same way they run
# loopback: the Deno child obtains the translator through the module
# graph (@polyengine/translator's packaged wasm), the browser child fetches
# both bundle + translator from its static server (prepared by
# _polyengine-browser-bundle).
run-interop: _results-dir polyengine-deps _polyengine-browser-prepared _polyengine-browser-bundle
    #!/usr/bin/env bash
    set -euo pipefail
    code=0
    for d in {{interop_directions}}; do
        echo "== interop $d =="
        timeout {{timeout}} {{driver}} interop {{pair_suite}} --direction "$d" \
            --composed-pair {{composed_pair}} \
            --deno-script {{polyengine}}/run.ts --browser-script {{polyengine}}/run-browser.mjs \
            -o {{results}}/"$d".jsonl || code=1
    done
    echo "== interop reference (self-pair) =="
    timeout {{timeout}} {{driver}} interop {{pair_suite}} \
        --direction reference-x-reference --target reference \
        -o {{results}}/reference.jsonl || code=1
    # Per-direction failures surface through the aggregate (which knows
    # the expected-fail declarations); a leg-level crash still fails here.
    exit 0

# ---------------------------------------------------------------------------
# Aggregation: validate every stream against its lockfile + manifest and
# render the matrices; the committed copies are the review surface.
# ---------------------------------------------------------------------------

aggregate: _ct-tools
    #!/usr/bin/env bash
    set -euo pipefail
    {{ct_cli}} aggregate \
        --lock conformance/guest-ct/tests.lock \
        --manifest conformance/driver-ct/targets.toml \
        --results wasmtime={{results}}/wasmtime.jsonl \
        --results composed={{results}}/composed.jsonl \
        --results polyengine-deno={{results}}/polyengine-deno.jsonl \
        --results polyengine-browser={{results}}/polyengine-browser.jsonl \
        -o {{results}}/matrix.md
    args=(aggregate --lock conformance/guest-pair-ct/tests.lock \
        --manifest conformance/driver-ct/targets-interop.toml \
        --results reference={{results}}/reference.jsonl)
    for d in {{interop_directions}}; do
        args+=(--results "$d"={{results}}/"$d".jsonl)
    done
    {{ct_cli}} "${args[@]}" -o {{results}}/matrix-interop.md

matrix-check:
    diff -u conformance/driver-ct/matrix.md {{results}}/matrix.md
    diff -u conformance/driver-ct/matrix-interop.md {{results}}/matrix-interop.md

# Refresh the committed matrices from a full run and commit the diff.
matrix-update:
    cp {{results}}/matrix.md conformance/driver-ct/matrix.md
    cp {{results}}/matrix-interop.md conformance/driver-ct/matrix-interop.md

# ---------------------------------------------------------------------------
# The network labs. Shadow (deterministic simulation, no root; CI runs
# it) and netns (real routed candidate paths; root, workstation-only).
# Lab rows aggregate against the pair lockfile + the lab manifest; the
# shadow matrix is gated by exit code, not a committed golden (the lab
# is not runnable on every workstation — e.g. no aarch64 shadow build).
# ---------------------------------------------------------------------------

shadow_rows := "wasmtime:wasmtime wasip3-guest:wasip3-guest reference:reference wasmtime:wasip3-guest wasip3-guest:wasmtime"

# Needs `shadow` on PATH (scripts/download-shadow.sh or
# scripts/build-shadow.sh; see AGENTS.md).
shadow: _results-dir
    #!/usr/bin/env bash
    set -euo pipefail
    command -v shadow >/dev/null || {
        echo "shadow is not on PATH; install it with scripts/download-shadow.sh (or scripts/build-shadow.sh)" >&2
        exit 1
    }
    for row in {{shadow_rows}}; do
        off="${row%%:*}"; ans="${row##*:}"
        if [ "$off" = "$ans" ]; then target="$off-shadow"; else target="$off-x-$ans-shadow"; fi
        echo "== shadow $target =="
        {{driver}} shadow {{pair_suite}} \
            --offerer-kind "$off" --answerer-kind "$ans" --target "$target" \
            --composed-pair {{composed_pair}} \
            --data-dir "target/shadow-data-$target" \
            -o {{results}}/"$target".jsonl || true
    done
    just conformance::aggregate-shadow

aggregate-shadow: _ct-tools
    {{ct_cli}} aggregate \
        --lock conformance/guest-pair-ct/tests.lock \
        --manifest conformance/driver-ct/targets-shadow.toml \
        --results wasmtime-shadow={{results}}/wasmtime-shadow.jsonl \
        --results wasip3-guest-shadow={{results}}/wasip3-guest-shadow.jsonl \
        --results reference-shadow={{results}}/reference-shadow.jsonl \
        --results wasmtime-x-wasip3-guest-shadow={{results}}/wasmtime-x-wasip3-guest-shadow.jsonl \
        --results wasip3-guest-x-wasmtime-shadow={{results}}/wasip3-guest-x-wasmtime-shadow.jsonl \
        -o {{results}}/matrix-shadow.md

# One netns scenario (lan | stun-srflx | turn-relay | nat-symmetric);
# needs sudo, iproute2, nftables, and coturn (scripts/setup.sh installs
# them). Aggregate ad hoc with targets-netns.toml when running several.
netns scenario:
    mkdir -p {{results}}
    sudo -E {{driver}} netns {{pair_suite}} --scenario {{scenario}} \
        -o {{results}}/wasmtime-{{scenario}}.jsonl

aggregate-netns: _ct-tools
    {{ct_cli}} aggregate \
        --lock conformance/guest-pair-ct/tests.lock \
        --manifest conformance/driver-ct/targets-netns.toml \
        --results wasmtime-lan={{results}}/wasmtime-lan.jsonl \
        --results wasmtime-stun-srflx={{results}}/wasmtime-stun-srflx.jsonl \
        --results wasmtime-turn-relay={{results}}/wasmtime-turn-relay.jsonl \
        --results wasmtime-nat-symmetric={{results}}/wasmtime-nat-symmetric.jsonl \
        -o {{results}}/matrix-netns.md
