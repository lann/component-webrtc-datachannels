// The `webrtc-consumer` world.
//
// A minimal consumer of `polymorph:webrtc-datachannels/connections`: it imports the
// guest-driven `peer-connection` surface and, composed with a provider
// component that exports `connections`, exercises a full in-guest WebRTC
// round trip.
//
// The world deliberately declares only the `connections` import a composition
// must satisfy; the component's `wasi:cli/run` export and stdio imports are
// declared by its own language bindings rather than here.
package demo:webrtc-consumer;

world consumer {
    import polymorph:webrtc-datachannels/connections@0.1.0;
}
